# ─── Email / SMTP Configuration ──────────────────────────────────────────────
#
# Add these to your .env.local file (copy this file and rename it).
# NEVER commit .env.local to git.
#
# ── Option A: cPanel / Hosting SMTP (recommended for pakoshaft.com) ──────────
SMTP_HOST=mail.pakoshaft.com
SMTP_PORT=587
SMTP_USER=noreply@pakoshaft.com
SMTP_PASS=your_email_password_here
SMTP_FROM="Pako Engineers" <noreply@pakoshaft.com>

# ── Option B: Gmail SMTP (use an App Password, not your real password) ────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.gmail@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM="Pako Engineers" <your.gmail@gmail.com>
#
# To create a Gmail App Password:
#   1. Go to myaccount.google.com > Security > 2-Step Verification
#   2. Scroll down to "App passwords" and generate one for "Mail"

# ── Option C: Brevo / SendGrid / Mailgun (transactional email services) ──────
# These give better deliverability than cPanel SMTP for production use.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login@email.com
# SMTP_PASS=your_brevo_smtp_key
